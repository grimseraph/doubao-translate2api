{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "doubao-translate2api-lite",
  "main": ".artifacts/workers-lite/worker.js",
  "build": { "command": "npm run build:workers:lite", "watch_dir": "src/workers-lite" },
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "minify": true,
  "secrets": { "required": ["API_KEY", "DOUBAO_COOKIE"] },
  "vars": { "DOUBAO_DEFAULT_TARGET_LANG": "zh" }
}
