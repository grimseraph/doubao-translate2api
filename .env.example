# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Client authentication: omit to generate and persist a key in ADMIN_DATA_DIR/api-key.txt.
# API_KEY=your-manual-api-key
# API_KEYS=key1,key2
ALLOW_NO_AUTH=false

# Local npm development can override this to ./data/cookie.txt.
DOUBAO_COOKIE_FILE=/data/cookie.txt
DOUBAO_DEFAULT_SCENE=2
# Fallback for client probes without a target language; explicit requests take precedence.
# DOUBAO_DEFAULT_TARGET_LANG=zh
DOUBAO_REQUEST_TIMEOUT_MS=45000
DOUBAO_TOTAL_TIMEOUT_MS=180000
DOUBAO_AUTH_TIMEOUT_MS=10000
DOUBAO_MAX_RETRIES=2
DOUBAO_MAX_CONCURRENCY=8
DOUBAO_QUEUE_MAX=100
DOUBAO_QUEUE_TIMEOUT_MS=30000
# DOUBAO_USER_AGENT=
# CORS_ORIGINS=https://your-client.example.com

# Management UI at /admin. Password is generated only on first startup.
ADMIN_ENABLED=true
# ADMIN_DATA_DIR=./data/admin
# ADMIN_PASSWORD=your-initial-management-password
ADMIN_COOKIE_SECURE=false
# ADMIN_ORIGIN=https://your-api.example.com
# TRUST_PROXY=127.0.0.1,::1

# Docker: non-root UID/GID matching the cookie file owner.
APP_UID=1000
APP_GID=1000
BIND_ADDRESS=127.0.0.1
