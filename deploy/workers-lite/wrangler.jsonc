{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "doubao-translate2api-lite",
  "main": "worker.js",
  "build": { "command": "npm run build", "watch_dir": ["worker.js", "check-size.mjs"] },
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "minify": true,
  "secrets": { "required": ["API_KEY", "DOUBAO_COOKIE"] },
  "vars": { "DOUBAO_DEFAULT_TARGET_LANG": "zh" }
}
